<!doctype html>
<!-- ウォーターメロン・インベストメンツ合同会社 コーポレートサイト -->
<html lang="ja">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>ウォーターメロン・インベストメンツ合同会社</title>
<style>
/* ------------------------------------------------------------------
   案1 Institutional Split
   白い「企業の顔」（ヘッダー）と、濃紺の「事業の世界」を分ける。
   ロゴはヘッダーの完全な白背景だけに置く。
   ロゴの赤 #FF0000 / 緑 #92D050 はサイト内で一切再利用しない。
   ------------------------------------------------------------------ */

:root{
  --hdr:76px;
  --white:#FFFFFF;
  --paper:#F7FAFC;
  --navy:#071A36;
  --ink:#0A1830;
  --link:#0D5CBF;
  --sub:#5E6F86;
  --rule:#D9E4F0;
  --label:#C22128;              /* 英字ラベル専用（明色地） */
  --label-dark:#E8656B;         /* 同・濃紺地の上（4.5:1 確保のための明度調整） */
  --ink-on-dark:#C9D6E6;
  --sub-on-dark:#8FA4BE;
  --link-on-dark:#8FB8F0;
  --rule-on-dark:rgba(217,228,240,.22);
  --font:-apple-system, BlinkMacSystemFont, "Hiragino Sans", "Yu Gothic UI", "Yu Gothic", Meiryo, sans-serif;
}

*,*::before,*::after{box-sizing:border-box}
html{-webkit-text-size-adjust:100%;color-scheme:light}
p,dd,li{text-wrap:pretty}
.note,.sec-head h2,.hero h1{text-wrap:balance}
body{
  margin:0;
  background:var(--paper);
  color:var(--ink);
  font-family:var(--font);
  font-size:16px;
  line-height:1.8;
  font-weight:400;
  -webkit-font-smoothing:antialiased;
}
img{display:block;max-width:100%;height:auto}
a{color:var(--link)}
h1,h2,h3{margin:0;line-height:1.25;letter-spacing:-.025em;font-weight:800}
p{margin:0}
ul,ol,dl,dd{margin:0;padding:0}
li{list-style:none}

.wrap{
  width:100%;
  max-width:1160px;
  margin:0 auto;
  padding-left:clamp(16px,4vw,32px);
  padding-right:clamp(16px,4vw,32px);
}

/* 英字ラベル（赤はここだけ） */
.eyebrow{
  font-size:11.5px;
  font-weight:700;
  letter-spacing:.10em;
  line-height:1.4;
  color:var(--label);
  margin:0 0 10px;
}
.on-dark .eyebrow{color:var(--label-dark)}

/* 節見出し（2px の罫で始まる＝Factsheet の様式） */
.sec-head{border-top:2px solid var(--ink);padding-top:18px;margin-bottom:clamp(28px,4vw,40px)}
.on-dark .sec-head{border-top-color:rgba(255,255,255,.55)}
.sec-head h2{font-size:clamp(1.375rem,1.06rem + 1.25vw,1.875rem)}
.on-dark .sec-head h2{color:#fff}

section{padding:clamp(56px,8vw,96px) 0}
.bg-paper{background:var(--paper)}
.bg-white{background:var(--white);color:var(--ink)}
.bg-navy{background:var(--navy);color:var(--ink-on-dark)}

/* ---------- 1. ヘッダー：完全な白。ロゴが置ける唯一の場所 ---------- */
/* スクロールしても残す。ナビがアンカーなので、消えると機能しない */
.site-header{
  background:var(--white);
  border-bottom:1px solid var(--rule);
  position:sticky;
  top:0;
  z-index:50;
}
/* 固定ヘッダーの下に見出しが潜らないよう、飛び先に余白を持たせる。
   --hdr はヘッダーの実高。幅で変わるのでメディアクエリ側でも上書きする */
[id]{scroll-margin-top:calc(var(--hdr) + 14px)}
html{scroll-behavior:smooth}
.header-row{
  height:76px;
  display:flex;
  align-items:center;
  justify-content:space-between;
  gap:24px;
}
.logo{width:clamp(190px,20vw,240px);min-width:0}
.nav{display:flex;align-items:center;gap:28px;flex-wrap:wrap;min-width:0}
.nav a{
  color:var(--ink);
  text-decoration:none;
  font-size:11.5px;
  font-weight:700;
  letter-spacing:.10em;
  white-space:nowrap;
}
.nav a:hover{color:var(--link)}
.nav-mobile{display:none}

@media (max-width:639px){
  :root{--hdr:103px}
  .header-row{height:64px}
  .header-row .nav{display:none}
  .nav-mobile{
    display:flex;
    justify-content:space-between;
    align-items:center;
    gap:8px;
    border-top:1px solid var(--rule);
    padding:9px 0;
  }
  .nav-mobile a{font-size:10.5px;letter-spacing:.07em}
}

/* ---------- 2. ヒーロー：ヘッダーのすぐ下から濃紺の世界が始まる ---------- */
.hero{padding:clamp(72px,11vw,132px) 0 clamp(64px,9vw,116px)}
.hero h1{
  font-size:clamp(1.75rem,1.12rem + 2.7vw,3rem);
  font-weight:900;
  letter-spacing:-.03em;
  color:#fff;
  max-width:21em;
  text-wrap:balance;
}
.hero p{
  margin-top:clamp(20px,3vw,28px);
  max-width:34em;
  color:var(--ink-on-dark);
  font-size:clamp(15px,14.2px + .25vw,17px);
  line-height:1.9;
}
.cta{
  display:inline-block;
  margin-top:clamp(28px,4vw,40px);
  background:var(--link);
  border:1px solid rgba(255,255,255,.24);
  border-radius:2px;
  color:#fff;
  text-decoration:none;
  font-size:15px;
  font-weight:700;
  letter-spacing:-.01em;
  padding:15px 26px;
}
.cta:hover{background:#0B4EA3}

/* ---------- 3. PRODUCTS ---------- */
.biz{margin:0;padding:0;list-style:none}
.biz li{position:relative;padding-left:15px;margin-bottom:5px}
.biz li:last-child{margin-bottom:0}
.biz li::before{content:"";position:absolute;left:0;top:.72em;width:5px;height:5px;background:#0d5cbf}
.products-grid{
  display:grid;
  grid-template-columns:repeat(auto-fit,minmax(min(340px,100%),1fr));
  gap:24px;
  align-items:start;
}
.product{
  background:var(--white);
  color:var(--ink);
  border:1px solid var(--rule);
  border-radius:3px;
  padding:clamp(20px,3.2vw,32px);
  min-width:0;
}
.product-head{display:flex;flex-wrap:wrap;gap:20px;align-items:flex-start}
.app-icon{
  width:clamp(64px,10vw,88px);
  height:auto;
  border:1px solid var(--rule);
  border-radius:4px;
  flex:0 0 auto;
}
.product-id{flex:1 1 180px;min-width:0}
.region{
  display:inline-block;
  border:1px solid var(--rule);
  border-radius:2px;
  padding:2px 8px;
  font-size:10.5px;
  font-weight:700;
  letter-spacing:.10em;
  line-height:1.6;
  color:var(--sub);
  margin-bottom:10px;
}
.product-id h3{font-size:clamp(1.125rem,1.02rem + .45vw,1.375rem)}
.product-en{
  margin-top:6px;
  font-size:13px;
  line-height:1.6;
  letter-spacing:.01em;
  color:var(--sub);
  overflow-wrap:anywhere;
}
.meta{display:flex;flex-wrap:wrap;margin-top:12px}
.meta li{
  font-size:12.5px;
  line-height:1.6;
  color:var(--ink);
  padding:0 12px;
  border-left:1px solid var(--rule);
}
.meta li:first-child{padding-left:0;border-left:0}
.product-desc{
  margin-top:22px;
  padding-top:22px;
  border-top:1px solid var(--rule);
  font-size:15px;
  line-height:1.9;
  max-width:46em;
}

/* 罫線の表（仕様／会社概要／免責 で共通の様式） */
.facts{display:grid;grid-template-columns:minmax(0,190px) minmax(0,1fr);margin-top:24px}
.facts dt,.facts dd{border-top:1px solid var(--rule);padding:13px 0;min-width:0}
.facts dt{
  font-size:11.5px;
  font-weight:700;
  letter-spacing:.02em;
  line-height:1.7;
  color:var(--sub);
  padding-right:16px;
}
.facts dd{font-size:14.5px;line-height:1.75;overflow-wrap:anywhere;max-width:52em}
.facts.en-key dt{letter-spacing:.10em;color:var(--ink)}
@media (max-width:639px){
  .meta li{font-size:11.5px;padding:0 10px}
  .facts{grid-template-columns:minmax(0,1fr)}
  .facts dt{padding:14px 0 0}
  .facts dd{border-top:0;padding:2px 0 14px}
}

.actions{
  display:flex;
  flex-wrap:wrap;
  align-items:center;
  gap:16px 24px;
  margin-top:28px;
  padding-top:24px;
  border-top:1px solid var(--rule);
}
.btn{
  display:inline-block;
  background:var(--link);
  border-radius:2px;
  color:#fff;
  text-decoration:none;
  font-size:14.5px;
  font-weight:700;
  letter-spacing:-.01em;
  padding:13px 22px;
}
.btn:hover{background:#0B4EA3}
.store-links{display:flex;flex-wrap:wrap;gap:0 16px}
.store-links a{
  font-size:13px;
  font-weight:700;
  letter-spacing:.02em;
  color:var(--link);
  text-decoration:none;
  border-bottom:1px solid rgba(13,92,191,.4);
  padding-bottom:1px;
}
.store-links a:hover{border-bottom-color:var(--link)}

/* ---------- 4. WHY：文章だけ。幅を絞る ---------- */
.measure{max-width:720px}
.measure p{
  color:var(--ink-on-dark);
  font-size:clamp(15px,14.4px + .2vw,16.5px);
  line-height:2;
}
.measure p + p{margin-top:1.6em}

/* ---------- 5. BACKGROUND ---------- */
.note{
  margin-top:24px;
  font-size:13px;
  line-height:1.85;
  color:var(--sub);
  max-width:56em;
}

/* ---------- 8. フッター ---------- */
.site-footer{background:var(--navy);color:var(--sub-on-dark);padding:clamp(40px,6vw,56px) 0}
.site-footer .name{color:#fff;font-size:15px;font-weight:700;letter-spacing:-.02em;line-height:1.6}
.site-footer .name-en{margin-top:6px;font-size:12.5px;letter-spacing:.02em;line-height:1.6}
.site-footer .mail{margin-top:14px;font-size:12.5px;line-height:1.6;overflow-wrap:anywhere}
.site-footer .mail a{color:var(--link-on-dark);text-decoration:none;border-bottom:1px solid rgba(143,184,240,.45)}
</style>
</head>
<body>
<!-- ============ ヘッダー：ロゴが置ける唯一の白背景 ============ -->
<header class="site-header">
  <div class="wrap">
    <div class="header-row">
      <a href="#top" aria-label="ウォーターメロン・インベストメンツ合同会社">
        <img class="logo" src="logo.jpg" width="438" height="74" alt="ウォーターメロン・インベストメンツ合同会社">
      </a>
      <nav class="nav" aria-label="メインメニュー">
        <a href="#products">PRODUCTS</a>
        <a href="#company">COMPANY</a>
        <a href="privacy-policy.html">PRIVACY</a>
        <a href="en/">English</a>
      </nav>
    </div>
    <nav class="nav-mobile" aria-label="メインメニュー">
      <a href="#products">PRODUCTS</a>
      <a href="#company">COMPANY</a>
      <a href="privacy-policy.html">PRIVACY</a>
      <a href="#">EN</a>
    </nav>
  </div>
</header>

<main id="top">

  <!-- ============ ヒーロー：ここから濃紺の「事業の世界」 ============ -->
  <section class="bg-navy on-dark hero">
    <div class="wrap">
      <h1>不動産投資を、遊びながら理解できる形に。</h1>
      <p>ウォーターメロン・インベストメンツ合同会社は、不動産投資の意思決定プロセスを学べるソフトウェアを開発しています。</p>
      <a class="cta" href="#products">提供しているソフトウェアを見る</a>
    </div>
  </section>

  <!-- ============ PRODUCTS ============ -->
  <section class="bg-paper" id="products">
    <div class="wrap">
      <div class="sec-head">
        <p class="eyebrow">SOFTWARE</p>
        <h2>提供しているソフトウェア</h2>
      </div>

      <!-- 2本目が増えたら、この grid の中に同じ article を足すだけで横に並ぶ -->
      <div class="products-grid">
        <article class="product">
          <div class="product-head">
            <img class="app-icon" src="app-icon.jpg" width="1024" height="1024" alt="戦略的大家への道（日本編）">
            <div class="product-id">
              <p class="region">JAPAN</p>
              <h3>戦略的大家への道（日本編）</h3>
              <p class="product-en">Real Estate by the Numbers: Japan</p>
              <ul class="meta">
                <li>iOS / Android</li>
                <li>¥1,500 買い切り</li>
                <li>オフライン</li>
              </ul>
            </div>
          </div>

          <p class="product-desc">銀行から融資を引き、物件を買い、育てて売る。IRR・CCR・DSCR といった実務の指標を見ながら、AI 2人の投資家と同じ市場で競い合う不動産投資シミュレーションゲームです。</p>

          <dl class="facts">
            <dt>モデル</dt>
            <dd>CCIM／CPM の分析フレームワークに基づくキャッシュフローモデル</dd>
            <dt>シミュレーション</dt>
            <dd>融資条件・減価償却・税金・修繕・空室を織り込んだ月次</dd>
            <dt>解説</dt>
            <dd>19章の解説と用語集を内蔵</dd>
            <dt>通信</dt>
            <dd>通信を行わず、オフラインで完結</dd>
          </dl>

          <div class="actions">
            <a class="btn" href="/reig/">製品サイトを見る →</a>
          </div>
        </article>

        <article class="product">
          <div class="product-head">
            <img class="app-icon" src="app-icon-us.jpg" width="1024" height="1024" alt="戦略的大家への道（米国編）">
            <div class="product-id">
              <p class="region">UNITED STATES</p>
              <h3>戦略的大家への道（米国編）</h3>
              <p class="product-en">Real Estate by the Numbers USA</p>
              <ul class="meta">
                <li>iOS</li>
                <li>$19.99 買い切り</li>
                <li>オフライン</li>
              </ul>
            </div>
          </div>

          <p class="product-desc">米国の州を選び、6種類の融資商品から条件を組む。IRR・DSCR・Debt yield で案件を判定し、1031交換やバルーン満期まで織り込んだ、米国市場版のシミュレーションゲームです。</p>

          <dl class="facts">
            <dt>モデル</dt>
            <dd>CCIM／CPM の分析フレームワークに基づくキャッシュフローモデル</dd>
            <dt>市場</dt>
            <dd>米国89市場から選択</dd>
            <dt>融資</dt>
            <dd>Conventional・FHA・DSCR・銀行・エージェンシーなど6商品</dd>
            <dt>通信</dt>
            <dd>通信を行わず、オフラインで完結</dd>
          </dl>

          <div class="actions">
            <a class="btn" href="/reig-us/">製品サイトを見る →</a>
          </div>
        </article>
      </div>
    </div>
  </section>

  <!-- ============ WHY：文章だけで見せる ============ -->
  <section class="bg-navy on-dark">
    <div class="wrap">
      <div class="measure">
        <div class="sec-head">
          <p class="eyebrow">WHY WE BUILD IT</p>
          <h2>なぜこれを作るのか</h2>
        </div>
        <p>不動産投資の難しさは、判断材料が多いことよりも、その判断が正しかったかどうかが数年後にしか分からないことにあります。</p>
        <p>実務では一度しか試せない意思決定を、繰り返し試せる形にすること。それが私たちのつくるものの目的です。</p>
      </div>
    </div>
  </section>

  
  <!-- ============ COMPANY：Factsheet ============ -->
  <section class="bg-paper" id="company">
    <div class="wrap">
      <div class="sec-head">
        <p class="eyebrow">COMPANY</p>
        <h2>会社概要</h2>
      </div>
      <dl class="facts" style="margin-top:0">
        <dt>商号</dt>
        <dd>ウォーターメロン・インベストメンツ合同会社<br>Watermelon Investments Limited Liability Co.</dd>
        <dt>事業内容</dt>
        <dd>
          <ul class="biz">
            <li>不動産賃貸業</li>
            <li>住宅宿泊事業（民泊）</li>
            <li>保有不動産の資産管理・運用</li>
            <li>教育事業（不動産・投資に関する教材およびソフトウェアの企画・開発・提供）</li>
          </ul>
        </dd>
        <dt>D-U-N-S 番号</dt>
        <dd>692970840</dd>
        <dt>お問い合わせ</dt>
        <dd><a href="mailto:info@watermelon-investments.com">info@watermelon-investments.com</a></dd>
      </dl>
    </div>
  </section>

  <!-- ============ 免責・プライバシー ============ -->
  <section class="bg-white">
    <div class="wrap">
      <div class="sec-head">
        <h2>免責・プライバシー</h2>
      </div>
      <dl class="facts" style="margin-top:0">
        <dt>免責</dt>
        <dd>当社のアプリは教育目的のシミュレーションゲームです。投資助言・勧誘を行うものではなく、実在する物件・企業・金融機関を再現したものでもありません。ゲーム内の数値は学習のために簡略化されたモデルであり、実際の取引条件を保証するものではありません。</dd>
        <dt>プライバシー</dt>
        <dd>当社のアプリは利用者の個人情報を一切収集しません。<br>詳細は<a href="privacy-policy.html">プライバシーポリシー</a>をご覧ください。</dd>
      </dl>
    </div>
  </section>

</main>

<!-- ============ フッター：濃紺。ロゴは置かない ============ -->
<footer class="site-footer">
  <div class="wrap">
    <p class="name">ウォーターメロン・インベストメンツ合同会社</p>
    <p class="name-en">Watermelon Investments Limited Liability Co.</p>
    <p class="mail"><a href="mailto:info@watermelon-investments.com">info@watermelon-investments.com</a></p>
  </div>
</footer>
</body>
